{
  "name": "reel-finisher",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run editor:build && next dev",
    "build": "npm run editor:build && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run editor:check",
    "e2e": "node tests/e2e/lab.e2e.mjs && node tests/e2e/studio.e2e.mjs && node tests/e2e/server.e2e.mjs && node tests/e2e/phone.e2e.mjs && node tests/e2e/silence.e2e.mjs && node tests/e2e/advanced.e2e.mjs && node tests/e2e/manual.e2e.mjs && node tests/e2e/ripple.e2e.mjs && npm run e2e:editor",
    "perf": "node tests/perf/phone-sim.mjs",
    "compat-pack": "node tests/compat/make-pack.mjs",
    "sync-check": "node tests/sync/sync-check.mjs",
    "bakeoff": "node tests/bakeoff/bakeoff.mjs",
    "editor:build": "node scripts/build-editor.mjs",
    "editor:check": "node scripts/check-editor.mjs",
    "e2e:editor": "node tests/e2e/openreel.e2e.mjs && node tests/e2e/openreel-migration.e2e.mjs"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "mediabunny": "^1.62.1",
    "next": "16.4.3",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
