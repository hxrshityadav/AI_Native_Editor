# Server-only. Never prefix these with NEXT_PUBLIC_.

# Required for /api/transcribe. Create at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Defaults to whisper-large-v3. Alternative: whisper-large-v3-turbo (cheaper, less accurate).
GROQ_MODEL=

# Optional in development (a random per-process salt is used). Set a long random value in production.
RATE_LIMIT_SALT=

# Optional. Model that converts Hindi-script words to Roman-script Hinglish. Defaults to openai/gpt-oss-120b.
GROQ_ROMANIZE_MODEL=

# Abuse controls. Required on any Vercel deployment (transcription stays off without them); optional locally.
# Postgres connection string for the shared rate limiter (Neon, Supabase, Vercel Postgres, ...). A pooled
# URL is fine. The table is created on first use. Without it, an in-memory limiter is used.
DATABASE_URL=
# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile). The check is on only when both are set.
# Local testing: Cloudflare's test keys 1x00000000000000000000AA / 1x0000000000000000000000000000000AA.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
